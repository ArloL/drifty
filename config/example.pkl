/// Example configuration. Not a real account — it exists so `./mvnw exec:java`
/// and PklConfigLoaderTest have something to evaluate, and so SPEC.md can
/// point at a complete config.
amends "drifty.pkl"

local checkActions = new StatusCheck {
  context = "check-actions.required-status-check"
  appId = module.githubActionsAppId
}

local mainRuleset: Ruleset = new {
  includePatterns { "refs/heads/main" }
  requiredLinearHistory = true
  noForcePushes = true
  requiredStatusChecks { checkActions }
}

local defaultRepo: Repository = new {
  allowMergeCommit = false
  allowAutoMerge = true
  deleteBranchOnMerge = true
  rulesets { ["main"] = mainRuleset }
}

organizations {
  ["example-org"] {
    description = "An example organization"
    membersCanCreatePages = false
    membersCanForkPrivateRepositories = true
    actionsPermissions { allowedActions = "local_only" }
    defaultWorkflowPermissions = "read"
    // Value read from DRIFTY_GITHUB_SECRETS under "org-example-org-NPM_TOKEN".
    actionsSecrets { ["NPM_TOKEN"] = new OrgSecret { visibility = "all" } }
    actionsVariables { ["REGISTRY"] = new OrgVariable { value = "ghcr.io"; visibility = "all" } }
    // Secret under "org-example-org-webhook-audit".
    webhooks {
      ["audit"] = new Webhook { url = "https://audit.example.com/github"; contentType = "json"; secret = true }
    }
    customProperties {
      ["tier"] = new CustomProperty {
        valueType = "single_select"
        defaultValue = "silver"
        allowedValues { "gold"; "silver" }
      }
    }
    rulesets {
      ["default-branch"] = new OrgRuleset {
        includePatterns { "~DEFAULT_BRANCH" }
        repositoryNameInclude { "~ALL" }
        noForcePushes = true
      }
      // A push ruleset has no ref patterns; it applies to every push.
      ["no-binaries"] = new OrgRuleset {
        target = "push"
        repositoryNameInclude { "~ALL" }
        fileExtensionRestrictions { "*.exe"; "*.dll" }
        maxFileSize = 50
      }
    }
    codeSecurityConfigurations {
      ["baseline"] = new CodeSecurityConfiguration {
        dependencyGraphAutosubmitAction = "enabled"
        // Submit dependencies from runners labeled "dependency-submission",
        // e.g. because the public registries are unreachable from the build
        // network. Always compared: GitHub answers it on every configuration.
        dependencyGraphAutosubmitLabeledRunners = true
        codeScanningDefaultSetup = "enabled"
        // Repositories running their own code scanning workflow stay
        // attached; omit the block to leave GitHub's value alone.
        codeScanningOptions { allowAdvanced = true }
        secretScanning = "enabled"
        secretScanningPushProtection = "enabled"
        secretScanningDelegatedBypass = "enabled"
        // Team id 5 may approve bypass requests; omit the block to leave
        // whatever reviewers GitHub has.
        secretScanningDelegatedBypassOptions {
          reviewers { new { reviewerId = 5; reviewerType = "TEAM" } }
        }
        defaultForNewRepos = "all"
      }
    }
    teams {
      ["core"] = new Team { description = "Owns the services"; maintainers { "example-user" } }
    }
    members { ["example-user"] = "admin" }
    // Runner groups exist only on paid plans; a free organization would
    // exclude "org_runner_groups" through `managed` instead.
    runnerGroups { ["Default"] = new RunnerGroup { allowsPublicRepositories = true } }
    repositories {
      (defaultRepo) {
        name = "example-service"
        environments {
          ["production"] = new Environment { secrets { "TF_TOKEN" } }
        }
        actionsVariables { ["REGION"] = "eu" }
        // Secret under "example-service-webhook-ci".
        webhooks {
          ["ci"] = new Webhook { url = "https://ci.example.com/hook"; events { "push"; "pull_request" }; secret = true }
        }
        customProperties { ["tier"] = "gold" }
        teamPermissions { ["core"] = "maintain" }
      }
      (defaultRepo) {
        name = "example-library"
        topics { "java"; "library" }
      }
      (defaultRepo) {
        name = "shared-with-another-team"
        managed { mode = "all_except"; groups { "action_secrets"; "rulesets" } }
      }
    }
  }
}

users {
  ["example-user"] {
    repositories {
      (defaultRepo) { name = "personal-site"; pages = new Pages {} }
    }
  }
}
