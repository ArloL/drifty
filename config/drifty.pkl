/// Drifty configuration schema — desired state for GitHub repositories.
module drifty

/// GitHub App ID for GitHub Actions
githubActionsAppId: Int = 15368
/// GitHub App ID for GitHub Advanced Security
githubAdvancedSecurityAppId: Int = 57789

typealias WorkflowPermissions = "read" | "write"
typealias Visibility = "public" | "private" | "internal"
typealias AlertsThreshold = "none" | "errors" | "errors_and_warnings" | "all"
typealias SecurityAlertsThreshold =
  "none" | "critical" | "high_or_higher" | "medium_or_higher" | "all"
typealias PatternOperator = "starts_with" | "ends_with" | "contains" | "regex"
typealias ActorType = "Integration" | "OrganizationAdmin" | "RepositoryRole" | "Team"
typealias BypassMode = "always" | "pull_request"
typealias SecretScanningBypassReviewerType = "TEAM" | "ROLE"
typealias SquashMergeCommitTitle = "PR_TITLE" | "COMMIT_OR_PR_TITLE"
typealias SquashMergeCommitMessage = "PR_BODY" | "COMMIT_MESSAGES" | "BLANK"
typealias MergeCommitTitle = "PR_TITLE" | "MERGE_MESSAGE"
typealias MergeCommitMessage = "PR_BODY" | "PR_TITLE" | "BLANK"

/// Every drift group drifty can check. Used by Managed.groups; the union is
/// what makes a misspelled group name fail at config-eval time instead of
/// silently leaving a group unmanaged.
typealias GroupName =
  "action_secrets"
    | "action_variables"
    | "advanced_security"
    | "archived"
    | "automated_security_fixes"
    | "branch_protection"
    | "code_scanning_default_setup"
    | "collaborators"
    | "custom_properties"
    | "environment_config"
    | "environment_secrets"
    | "environment_variables"
    | "immutable_releases"
    | "pages"
    | "private_vulnerability_reporting"
    | "repo_settings"
    | "rulesets"
    | "secret_scanning"
    | "secret_scanning_ai_detection"
    | "secret_scanning_delegated_alert_dismissal"
    | "secret_scanning_delegated_bypass"
    | "secret_scanning_non_provider_patterns"
    | "secret_scanning_push_protection"
    | "secret_scanning_validity_checks"
    | "topics"
    | "vulnerability_alerts"
    | "webhooks"
    | "workflow_permissions"

/// Every drift group drifty can check on an organization. Separate from
/// GroupName because neither scope's groups can be checked on the other, and
/// the union is what makes a name from the wrong scope fail at config-eval.
typealias OrgGroupName =
  "org_settings"
    | "org_actions_permissions"
    | "org_workflow_permissions"
    | "org_action_secrets"
    | "org_action_variables"
    | "org_webhooks"
    | "org_custom_properties"
    | "org_rulesets"
    | "org_code_security_configurations"
    | "org_teams"
    | "org_members"
    | "org_runner_groups"

typealias SecretVisibility = "all" | "private" | "selected"

typealias ActionsEnabledRepositories = "all" | "none" | "selected"
typealias AllowedActions = "all" | "local_only" | "selected"

typealias ManageMode = "all_except" | "only"

/// Which drift groups drifty manages for a repository. The default manages
/// everything: mode "all_except" with nothing excluded.
class Managed {
  mode: ManageMode = "all_except"
  groups: Listing<GroupName> = new {}
}

/// Which drift groups drifty manages for an organization. Same default as
/// Managed: everything.
class OrgManaged {
  mode: ManageMode = "all_except"
  groups: Listing<OrgGroupName> = new {}
}

typealias RepositoryPermission = "none" | "read" | "write" | "admin"

class SecretScanningBypassReviewer {
  reviewerId: Int
  reviewerType: SecretScanningBypassReviewerType
}

class StatusCheck {
  context: String
  /// Omit (null) to allow any app to report this check; set to a GitHub App ID
  /// (e.g. githubActionsAppId) to require that specific app. Mirrors the
  /// optional app_id in GitHub's branch protection / ruleset APIs.
  appId: Int? = null
}

class CodeScanningTool {
  tool: String
  alertsThreshold: AlertsThreshold = "errors"
  securityAlertsThreshold: SecurityAlertsThreshold = "high_or_higher"
}

class RulePattern {
  name: String?
  negate: Boolean = false
  operator: PatternOperator
  pattern: String
}

class BypassActor {
  actorId: Int
  actorType: ActorType
  bypassMode: BypassMode
}

/// What a ruleset applies to. A "push" ruleset has no ref conditions: it
/// applies to every push to the repository, forks included, and the only
/// rules GitHub accepts on it are the file ones (filePathRestrictions,
/// maxFilePathLength, fileExtensionRestrictions, maxFileSize). A
/// "repository" ruleset is an organization ruleset only; it selects
/// repositories with the repository conditions and has no ref conditions
/// either.
typealias RulesetTarget = "branch" | "tag" | "push" | "repository"
typealias RulesetEnforcement = "active" | "evaluate" | "disabled"
typealias MergeMethod = "merge" | "squash" | "rebase"
typealias MergeQueueGroupingStrategy = "ALLGREEN" | "HEADGREEN"
typealias MergeQueueMergeMethod = "MERGE" | "SQUASH" | "REBASE"

/// The pull_request rule. Its presence on a Ruleset is what requires pull
/// requests before merging; the defaults are GitHub's for a new rule.
class PullRequestRule {
  requiredApprovingReviewCount: Int = 0
  dismissStaleReviewsOnPush: Boolean = false
  requireCodeOwnerReview: Boolean = false
  requireLastPushApproval: Boolean = false
  requiredReviewThreadResolution: Boolean = false
  /// Leave empty to allow every merge method.
  allowedMergeMethods: Listing<MergeMethod> = new {}
}

/// The merge_queue rule, with GitHub's defaults for a new queue.
class MergeQueueRule {
  checkResponseTimeoutMinutes: Int = 60
  groupingStrategy: MergeQueueGroupingStrategy = "ALLGREEN"
  maxEntriesToBuild: Int = 5
  maxEntriesToMerge: Int = 5
  mergeMethod: MergeQueueMergeMethod = "MERGE"
  minEntriesToMerge: Int = 1
  minEntriesToMergeWaitMinutes: Int = 5
}

/// A workflow that must pass before merging, for the workflows rule.
class WorkflowRule {
  /// Path of the workflow file, e.g. ".github/workflows/ci.yml".
  path: String
  /// Id of the repository the workflow lives in.
  repositoryId: Int
  /// Branch, tag or SHA to take the workflow from; omit for the default branch.
  ref: String?
}

/// A repository ruleset. The ruleset name is the key in Repository.rulesets.
/// The ref patterns are only for a "branch" or "tag" target; a "push" or
/// "repository" ruleset has no ref conditions, so the listings must stay
/// empty there.
open class Ruleset {
  target: RulesetTarget = "branch"
  enforcement: RulesetEnforcement = "active"
  includePatterns: Listing<String>(isEmpty || hasRefConditions) = new {}
  excludePatterns: Listing<String>(isEmpty || hasRefConditions) = new {}
  hidden hasRefConditions: Boolean = target == "branch" || target == "tag"
  requiredLinearHistory: Boolean = false
  noForcePushes: Boolean = false
  /// Whether branches must be up to date before merging.
  strictRequiredStatusChecks: Boolean = false
  requiredStatusChecks: Listing<StatusCheck> = new {}
  /// Set to require pull requests; omit to allow direct pushes.
  pullRequest: PullRequestRule?
  requiredCodeScanning: Listing<CodeScanningTool> = new {}
  creation: Boolean = false
  deletion: Boolean = false
  requiredSignatures: Boolean = false
  update: Boolean = false
  updateAllowsFetchAndMerge: Boolean = false
  commitMessagePattern: RulePattern?
  commitAuthorEmailPattern: RulePattern?
  committerEmailPattern: RulePattern?
  branchNamePattern: RulePattern?
  tagNamePattern: RulePattern?
  requiredDeployments: Listing<String> = new {}
  mergeQueue: MergeQueueRule?
  workflows: Listing<WorkflowRule> = new {}
  /// File paths that may not be committed.
  filePathRestrictions: Listing<String> = new {}
  maxFilePathLength: Int?
  /// File extensions that may not be committed.
  fileExtensionRestrictions: Listing<String> = new {}
  /// Largest file size in megabytes.
  maxFileSize: Int?
  bypassActors: Listing<BypassActor> = new {}
}

/// A repository property an organization ruleset selects repositories by.
class PropertyCondition {
  name: String
  propertyValues: Listing<String>
  source: "custom" | "system" = "custom"
}

/// An organization ruleset: every rule a repository ruleset has, plus the
/// conditions that pick the repositories it applies to. Repositories are
/// named, not listed by id: a name condition covers the same ground without
/// an id lookup.
class OrgRuleset extends Ruleset {
  repositoryNameInclude: Listing<String> = new {}
  repositoryNameExclude: Listing<String> = new {}
  /// Whether the ruleset also applies to repositories whose name condition
  /// GitHub marks as protected.
  repositoryNameProtected: Boolean = false
  repositoryPropertyInclude: Listing<PropertyCondition> = new {}
  repositoryPropertyExclude: Listing<PropertyCondition> = new {}
}

/// Legacy branch protection rule. The branch pattern is the key in Repository.branchProtections.
class BranchProtection {
  enforceAdmins: Boolean = false
  requiredLinearHistory: Boolean = false
  allowForcePushes: Boolean = false
  allowDeletions: Boolean = false
  blockCreations: Boolean = false
  lockBranch: Boolean = false
  allowForkSyncing: Boolean = false
  requireConversationResolution: Boolean = false
  /// Whether branches must be up to date before merging.
  strictStatusChecks: Boolean = false
  requiredStatusChecks: Listing<StatusCheck> = new {}
  requiredApprovingReviewCount: Int?
  dismissStaleReviews: Boolean = false
  requireCodeOwnerReviews: Boolean = false
  requireLastPushApproval: Boolean?
  /// Who may dismiss reviews: logins, team slugs and app slugs.
  dismissalUsers: Listing<String> = new {}
  dismissalTeams: Listing<String> = new {}
  dismissalApps: Listing<String> = new {}
  /// Who may push without a review: logins, team slugs and app slugs.
  bypassPullRequestUsers: Listing<String> = new {}
  bypassPullRequestTeams: Listing<String> = new {}
  bypassPullRequestApps: Listing<String> = new {}
  /// Who may push to the branch: logins, team slugs and app slugs.
  users: Listing<String> = new {}
  teams: Listing<String> = new {}
  apps: Listing<String> = new {}
}

class Pages {
  buildType: "workflow" | "legacy" = "workflow"
  /// Required when buildType = "legacy"
  sourceBranch: String?
  /// Required when buildType = "legacy"
  sourcePath: String?
}

typealias WebhookContentType = "json" | "form"

/// A webhook. GitHub has no name for one — every hook is called "web" — so
/// the key in `webhooks` is yours, and the url is what matches an entry to a
/// hook on GitHub.
class Webhook {
  url: String
  contentType: WebhookContentType = "form"
  insecureSsl: Boolean = false
  active: Boolean = true
  events: Listing<String> = new { "push" }
  /// Whether the hook carries a secret. GitHub never returns it; the value
  /// comes from DRIFTY_GITHUB_SECRETS under `<repo>-webhook-<name>` (or
  /// `org-<org>-webhook-<name>`) and the state file remembers what was pushed.
  secret: Boolean = false
}

typealias CustomPropertyValueType =
  "string" | "single_select" | "multi_select" | "true_false" | "url"
typealias CustomPropertyEditableBy = "org_actors" | "org_and_repo_actors"

/// A custom property definition. The property name is the key in
/// Organization.customProperties. Extra definitions on GitHub are reported and
/// never deleted: deleting one discards its value on every repository.
class CustomProperty {
  valueType: CustomPropertyValueType
  required: Boolean = false
  /// Default for every type but multi_select. A true_false property takes
  /// "true" or "false", which is how GitHub stores it.
  defaultValue: String?
  /// Default for a multi_select property.
  defaultValues: Listing<String> = new {}
  description: String?
  /// The choices of a single_select or multi_select property.
  allowedValues: Listing<String> = new {}
  valuesEditableBy: CustomPropertyEditableBy = "org_actors"
}

typealias SecuritySetting = "enabled" | "disabled" | "not_set"
typealias AdvancedSecuritySetting = "enabled" | "disabled" | "code_security" | "secret_protection"
typealias SecurityEnforcement = "enforced" | "unenforced"
typealias DefaultForNewRepos = "none" | "public" | "private_and_internal" | "all"
typealias CodeScanningRunnerType = "standard" | "labeled" | "not_set"
typealias SecretScanningBypassReviewerMode = "ALWAYS" | "EXEMPT"

/// Runner options for code scanning default setup on a code security
/// configuration. runnerLabel names the self-hosted runner label and is
/// required exactly when runnerType is "labeled".
class CodeScanningDefaultSetupOptions {
  runnerType: CodeScanningRunnerType = "standard"
  runnerLabel: String?((runnerType == "labeled") == (this != null))
}

/// A bypass reviewer on a code security configuration: the repository-level
/// SecretScanningBypassReviewer's two fields plus the mode GitHub gives it.
/// Not a subclass, since that would widen the repository's listing type on
/// the Java side.
class CodeSecurityBypassReviewer {
  reviewerId: Int
  reviewerType: SecretScanningBypassReviewerType
  mode: SecretScanningBypassReviewerMode = "ALWAYS"
}

/// Reviewer options for secret scanning delegated bypass on a code security
/// configuration. An empty listing wants no reviewers.
class SecretScanningDelegatedBypassOptions {
  reviewers: Listing<CodeSecurityBypassReviewer> = new {}
}

/// Code scanning feature options on a code security configuration.
/// allowAdvanced lets repositories that run their own code scanning workflow
/// stay attached to a configuration that enables default setup.
class CodeScanningOptions {
  allowAdvanced: Boolean = false
}

/// A code security configuration. The name is the key in
/// Organization.codeSecurityConfigurations; the defaults are GitHub's, so a
/// configuration created with only a name reports no drift. Extra
/// configurations on GitHub are reported and never deleted: deleting one
/// detaches every repository it is attached to.
class CodeSecurityConfiguration {
  description: String = ""
  advancedSecurity: AdvancedSecuritySetting = "disabled"
  dependencyGraph: SecuritySetting = "enabled"
  dependencyGraphAutosubmitAction: SecuritySetting = "disabled"
  /// Whether automatic dependency submission runs on runners labeled
  /// "dependency-submission" rather than standard GitHub runners. Flat rather
  /// than a nullable options object like the two below: GitHub returns
  /// dependency_graph_autosubmit_action_options on every configuration,
  /// including ones that never set it, so a default reports no false drift.
  dependencyGraphAutosubmitLabeledRunners: Boolean = false
  dependabotAlerts: SecuritySetting = "disabled"
  dependabotSecurityUpdates: SecuritySetting = "disabled"
  dependabotDelegatedAlertDismissal: SecuritySetting = "disabled"
  codeScanningDefaultSetup: SecuritySetting = "disabled"
  codeScanningDelegatedAlertDismissal: SecuritySetting = "not_set"
  secretScanning: SecuritySetting = "disabled"
  secretScanningPushProtection: SecuritySetting = "disabled"
  secretScanningDelegatedBypass: SecuritySetting = "disabled"
  secretScanningValidityChecks: SecuritySetting = "disabled"
  secretScanningNonProviderPatterns: SecuritySetting = "disabled"
  secretScanningGenericSecrets: SecuritySetting = "disabled"
  secretScanningDelegatedAlertDismissal: SecuritySetting = "not_set"
  privateVulnerabilityReporting: SecuritySetting = "disabled"
  enforcement: SecurityEnforcement = "enforced"
  /// Runner type and label for code scanning default setup. Omit to leave
  /// GitHub's untouched; set to compare and write both fields.
  codeScanningDefaultSetupOptions: CodeScanningDefaultSetupOptions?
  /// Reviewers for secret scanning delegated bypass. Omit to leave GitHub's
  /// untouched; set — even with no reviewers — to compare and write them.
  secretScanningDelegatedBypassOptions: SecretScanningDelegatedBypassOptions?
  /// Whether repositories on advanced code scanning setup may be attached.
  /// Omit to leave GitHub's untouched: GitHub omits the object entirely on a
  /// configuration that never set it, so a default would report drift on
  /// every one of them.
  codeScanningOptions: CodeScanningOptions?
  /// Which new repositories get this configuration by default.
  defaultForNewRepos: DefaultForNewRepos = "none"
  /// Repositories this configuration is attached to. Missing ones are
  /// attached; repositories attached outside the config are reported, not
  /// detached.
  repositories: Listing<String> = new {}
}

typealias CollaboratorPermission = "pull" | "triage" | "push" | "maintain" | "admin"
typealias OrgRole = "admin" | "member"
typealias TeamPrivacy = "closed" | "secret"
typealias TeamNotificationSetting = "notifications_enabled" | "notifications_disabled"

/// A team. The slug is the key in Organization.teams. GitHub derives the slug
/// from the name on creation, so a key that is not the slug of its own name
/// is created under one slug and reported missing under the other on the
/// next run. Members on GitHub that the config does not list are reported
/// and left in place; team repository access is managed from the repository
/// side by `teamPermissions`.
class Team {
  /// Display name; defaults to the slug the entry is keyed by.
  name: String?
  description: String = ""
  privacy: TeamPrivacy = "closed"
  notificationSetting: TeamNotificationSetting = "notifications_enabled"
  /// Parent team slug
  parent: String?
  /// Logins with the member role
  members: Listing<String> = new {}
  /// Logins with the maintainer role
  maintainers: Listing<String> = new {}
}

/// Deployment environment. The environment name is the key in Repository.environments.
class Environment {
  secrets: Listing<String> = new {}
  /// Actions variables, name to value. Plaintext, so the value is compared.
  variables: Mapping<String, String> = new {}
  waitTimer: Int = 0
  preventSelfReview: Boolean = false
  /// Logins of the users who must approve deployments.
  reviewerUsers: Listing<String> = new {}
  /// Slugs of the teams whose members may approve deployments. Only a
  /// repository owned by an organization can name one.
  reviewerTeams: Listing<String> = new {}
  protectedBranches: Boolean = false
  customBranchPolicies: Boolean = false
  /// Branch name patterns allowed to deploy; needs customBranchPolicies.
  deploymentBranchPatterns: Listing<String> = new {}
  /// Tag name patterns allowed to deploy; needs customBranchPolicies.
  deploymentTagPatterns: Listing<String> = new {}
}

/// Desired state for a single GitHub repository.
/// Defaults match GitHub's defaults for newly-created repos.
class Repository {
  name: String
  managed: Managed = new {}
  archived: Boolean = false
  description: String = ""
  homepageUrl: String = ""
  visibility: Visibility = "public"
  topics: Listing<String> = new {}
  defaultBranch: String = "main"

  hasIssues: Boolean = true
  hasProjects: Boolean = true
  hasWiki: Boolean = true
  hasDiscussions: Boolean = false
  isTemplate: Boolean = false
  allowForking: Boolean = true
  webCommitSignoffRequired: Boolean = false

  allowMergeCommit: Boolean = true
  allowSquashMerge: Boolean = true
  allowRebaseMerge: Boolean = true
  allowAutoMerge: Boolean = false
  deleteBranchOnMerge: Boolean = false
  allowUpdateBranch: Boolean = false
  squashMergeCommitTitle: SquashMergeCommitTitle = "COMMIT_OR_PR_TITLE"
  squashMergeCommitMessage: SquashMergeCommitMessage = "COMMIT_MESSAGES"
  mergeCommitTitle: MergeCommitTitle = "MERGE_MESSAGE"
  mergeCommitMessage: MergeCommitMessage = "PR_TITLE"

  vulnerabilityAlerts: Boolean = true
  automatedSecurityFixes: Boolean = false
  secretScanning: Boolean = true
  secretScanningPushProtection: Boolean = true
  secretScanningValidityChecks: Boolean = false
  secretScanningNonProviderPatterns: Boolean = false
  privateVulnerabilityReporting: Boolean = false
  codeScanningDefaultSetup: Boolean = false
  advancedSecurity: Boolean = false
  secretScanningAiDetection: Boolean = false
  secretScanningDelegatedAlertDismissal: Boolean = false
  secretScanningDelegatedBypass: Boolean = false
  secretScanningDelegatedBypassReviewers: Listing<SecretScanningBypassReviewer> = new {}

  defaultWorkflowPermissions: WorkflowPermissions = "write"
  canApprovePullRequestReviews: Boolean = true

  immutableReleases: Boolean = false
  pages: Pages?
  actionsSecrets: Listing<String> = new {}
  /// Actions variables, name to value. Plaintext, so the value is compared.
  actionsVariables: Mapping<String, String> = new {}

  /// Keyed by branch pattern (e.g. "main")
  branchProtections: Mapping<String, BranchProtection> = new {}
  /// Keyed by ruleset name. A "repository" target is an organization
  /// ruleset's; a repository ruleset targets branches, tags or pushes.
  rulesets: Mapping<String, Ruleset(target != "repository")> = new {}
  /// Keyed by environment name
  environments: Mapping<String, Environment> = new {}
  /// Keyed by a name of your choosing; the url is the identity on GitHub
  webhooks: Mapping<String, Webhook> = new {}
  /// Custom property values, name to value. A true_false property takes
  /// "true" or "false". Only the properties named here are compared: which
  /// properties exist is the organization's schema to decide.
  customProperties: Mapping<String, String> = new {}
  /// Values of multi_select properties, name to the selected values.
  customMultiSelectProperties: Mapping<String, Listing<String>> = new {}
  /// Direct collaborators, login to permission. A member who reaches the
  /// repository through an org role or a team is not one. Collaborators on
  /// GitHub that the config does not list are reported and left in place.
  collaborators: Mapping<String, CollaboratorPermission> = new {}
  /// Team access, team slug to permission. Only a repository under an
  /// organization can name a team.
  teamPermissions: Mapping<String, CollaboratorPermission> = new {}
}

class SelectedActions {
  githubOwnedAllowed: Boolean = true
  verifiedAllowed: Boolean = false
  patternsAllowed: Listing<String> = new {}
}

typealias RunnerGroupVisibility = "all" | "selected" | "private"

/// A self-hosted runner group. The name is the key in
/// Organization.runnerGroups. The group GitHub marks as the default is never
/// extra and never deleted; naming it manages its settings. Runner groups
/// exist only on paid plans, so on a free organization exclude the
/// `org_runner_groups` group through `managed`.
class RunnerGroup {
  visibility: RunnerGroupVisibility = "all"
  /// Only when visibility = "selected"
  selectedRepositories: Listing<String> = new {}
  allowsPublicRepositories: Boolean = false
  restrictedToWorkflows: Boolean = false
  /// Workflows that may use the group, as `owner/repo/path@ref`; only when
  /// restrictedToWorkflows is true.
  selectedWorkflows: Listing<String> = new {}
}

/// Organization Actions policy.
class ActionsPermissions {
  enabledRepositories: ActionsEnabledRepositories = "all"
  allowedActions: AllowedActions = "all"
  shaPinningRequired: Boolean = false
  /// Required when allowedActions = "selected"
  selectedActions: SelectedActions?
  /// The repositories Actions is enabled in; only when enabledRepositories =
  /// "selected".
  selectedRepositories: Listing<String> = new {}
}

/// An organization Actions secret. The name is the key in
/// Organization.actionsSecrets; the value comes from DRIFTY_GITHUB_SECRETS
/// under the key `org-<org>-<secret>`.
class OrgSecret {
  visibility: SecretVisibility = "private"
  /// Only when visibility = "selected"
  selectedRepositories: Listing<String> = new {}
}

/// An organization Actions variable. The name is the key in
/// Organization.actionsVariables; unlike a secret, the value is right here.
class OrgVariable {
  value: String
  visibility: SecretVisibility = "private"
  /// Only when visibility = "selected"
  selectedRepositories: Listing<String> = new {}
}

/// Desired state for a GitHub organization, keyed by login in `organizations`.
/// Defaults match GitHub's defaults for a new organization.
class Organization {
  managed: OrgManaged = new {}

  displayName: String = ""
  description: String = ""
  websiteUrl: String = ""
  company: String = ""
  email: String = ""
  location: String = ""
  twitterUsername: String = ""

  hasOrganizationProjects: Boolean = true
  hasRepositoryProjects: Boolean = true
  defaultRepositoryPermission: RepositoryPermission = "read"
  membersCanCreateRepositories: Boolean = true
  membersCanCreatePublicRepositories: Boolean = true
  membersCanCreatePrivateRepositories: Boolean = true
  membersCanCreateInternalRepositories: Boolean = false
  membersCanCreatePages: Boolean = true
  membersCanCreatePublicPages: Boolean = true
  membersCanCreatePrivatePages: Boolean = true
  membersCanForkPrivateRepositories: Boolean = false
  webCommitSignoffRequired: Boolean = false
  deployKeysEnabledForRepositories: Boolean = false

  /// Check-only below: GitHub returns these but PATCH /orgs/{org} accepts
  /// none of them, so drifty reports drift and never writes it.
  defaultRepositoryBranch: String = "main"
  twoFactorRequirementEnabled: Boolean = false
  membersCanDeleteRepositories: Boolean = true
  membersCanChangeRepoVisibility: Boolean = true
  membersCanInviteOutsideCollaborators: Boolean = true
  membersCanDeleteIssues: Boolean = false
  membersCanCreateTeams: Boolean = true
  membersCanViewDependencyInsights: Boolean = true
  readersCanCreateDiscussions: Boolean = false
  displayCommenterFullNameSettingEnabled: Boolean = false

  actionsPermissions: ActionsPermissions = new {}
  defaultWorkflowPermissions: WorkflowPermissions = "write"
  canApprovePullRequestReviews: Boolean = true

  /// Keyed by secret name
  actionsSecrets: Mapping<String, OrgSecret> = new {}
  /// Keyed by variable name
  actionsVariables: Mapping<String, OrgVariable> = new {}
  /// Keyed by a name of your choosing; the url is the identity on GitHub
  webhooks: Mapping<String, Webhook> = new {}
  /// Custom property definitions, keyed by property name
  customProperties: Mapping<String, CustomProperty> = new {}
  /// Organization rulesets, keyed by ruleset name
  rulesets: Mapping<String, OrgRuleset> = new {}
  /// Code security configurations, keyed by name
  codeSecurityConfigurations: Mapping<String, CodeSecurityConfiguration> = new {}
  /// Teams, keyed by slug
  teams: Mapping<String, Team> = new {}
  /// Members, login to role. A login missing from GitHub is invited by --fix
  /// and stays missing until the invitation is accepted; members the config
  /// does not list are reported and never removed.
  members: Mapping<String, OrgRole> = new {}
  /// Self-hosted runner groups, keyed by name
  runnerGroups: Mapping<String, RunnerGroup> = new {}

  repositories: Listing<Repository> = new {}
}

/// A personal account. It owns repositories and has no org-level settings —
/// which is why it is a separate type rather than a flag on Organization.
class User {
  repositories: Listing<Repository> = new {}
}

organizations: Mapping<String, Organization> = new {}
users: Mapping<String, User> = new {}

output {
  value = new Dynamic {
    organizations = module.organizations
    users = module.users
  }
}
