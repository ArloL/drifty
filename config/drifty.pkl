/// Drifty configuration schema — desired state for GitHub repositories.
module drifty

/// GitHub App ID for GitHub Actions
githubActionsAppId: Int = 15368
/// GitHub App ID for GitHub Advanced Security
githubAdvancedSecurityAppId: Int = 57789

typealias WorkflowPermissions = "read" | "write"
typealias Visibility = "public" | "private" | "internal"
typealias AlertsThreshold = "none" | "errors" | "errors_and_warnings" | "all"
typealias SecurityAlertsThreshold = "none" | "critical" | "high_or_higher" | "medium_or_higher" | "all"
typealias PatternOperator = "starts_with" | "ends_with" | "contains" | "regex"
typealias ActorType = "Integration" | "OrganizationAdmin" | "RepositoryRole" | "Team"
typealias BypassMode = "always" | "pull_request"
typealias SecretScanningBypassReviewerType = "TEAM" | "ROLE"
typealias SquashMergeCommitTitle = "PR_TITLE" | "COMMIT_OR_PR_TITLE"
typealias SquashMergeCommitMessage = "PR_BODY" | "COMMIT_MESSAGES" | "BLANK"
typealias MergeCommitTitle = "PR_TITLE" | "MERGE_MESSAGE"
typealias MergeCommitMessage = "PR_BODY" | "PR_TITLE" | "BLANK"

/// Every drift group drifty can check. Used by Managed.groups; the union is
/// what makes a misspelled group name fail at config-eval time instead of
/// silently leaving a group unmanaged.
typealias GroupName =
  "action_secrets"
  | "advanced_security"
  | "archived"
  | "automated_security_fixes"
  | "branch_protection"
  | "code_scanning_default_setup"
  | "environment_config"
  | "environment_secrets"
  | "immutable_releases"
  | "pages"
  | "private_vulnerability_reporting"
  | "repo_settings"
  | "rulesets"
  | "secret_scanning"
  | "secret_scanning_ai_detection"
  | "secret_scanning_delegated_alert_dismissal"
  | "secret_scanning_delegated_bypass"
  | "secret_scanning_non_provider_patterns"
  | "secret_scanning_push_protection"
  | "secret_scanning_validity_checks"
  | "topics"
  | "vulnerability_alerts"
  | "workflow_permissions"

/// Every drift group drifty can check on an organization. Separate from
/// GroupName because neither scope's groups can be checked on the other, and
/// the union is what makes a name from the wrong scope fail at config-eval.
typealias OrgGroupName =
  "org_settings"
  | "org_actions_permissions"
  | "org_workflow_permissions"
  | "org_action_secrets"

typealias SecretVisibility = "all" | "private" | "selected"

typealias ActionsEnabledRepositories = "all" | "none" | "selected"
typealias AllowedActions = "all" | "local_only" | "selected"

typealias ManageMode = "all_except" | "only"

/// Which drift groups drifty manages for a repository. The default manages
/// everything: mode "all_except" with nothing excluded.
class Managed {
  mode: ManageMode = "all_except"
  groups: Listing<GroupName> = new {}
}

/// Which drift groups drifty manages for an organization. Same default as
/// Managed: everything.
class OrgManaged {
  mode: ManageMode = "all_except"
  groups: Listing<OrgGroupName> = new {}
}

typealias RepositoryPermission = "none" | "read" | "write" | "admin"

class SecretScanningBypassReviewer {
  reviewerId: Int
  reviewerType: SecretScanningBypassReviewerType
}

class StatusCheck {
  context: String
  /// Omit (null) to allow any app to report this check; set to a GitHub App ID
  /// (e.g. githubActionsAppId) to require that specific app. Mirrors the
  /// optional app_id in GitHub's branch protection / ruleset APIs.
  appId: Int? = null
}

class CodeScanningTool {
  tool: String
  alertsThreshold: AlertsThreshold = "errors"
  securityAlertsThreshold: SecurityAlertsThreshold = "high_or_higher"
}

class RulePattern {
  name: String?
  negate: Boolean = false
  operator: PatternOperator
  pattern: String
}

class BypassActor {
  actorId: Int
  actorType: ActorType
  bypassMode: BypassMode
}

/// A repository ruleset. The ruleset name is the key in Repository.rulesets.
class Ruleset {
  includePatterns: Listing<String> = new {}
  requiredLinearHistory: Boolean = false
  noForcePushes: Boolean = false
  requiredStatusChecks: Listing<StatusCheck> = new {}
  requiredReviewCount: Int?
  requiredCodeScanning: Listing<CodeScanningTool> = new {}
  creation: Boolean = false
  deletion: Boolean = false
  requiredSignatures: Boolean = false
  update: Boolean = false
  updateAllowsFetchAndMerge: Boolean = false
  commitMessagePattern: RulePattern?
  commitAuthorEmailPattern: RulePattern?
  committerEmailPattern: RulePattern?
  branchNamePattern: RulePattern?
  tagNamePattern: RulePattern?
  requiredDeployments: Listing<String> = new {}
  bypassActors: Listing<BypassActor> = new {}
}

/// Legacy branch protection rule. The branch pattern is the key in Repository.branchProtections.
class BranchProtection {
  enforceAdmins: Boolean = false
  requiredLinearHistory: Boolean = false
  allowForcePushes: Boolean = false
  requireConversationResolution: Boolean = false
  requiredStatusChecks: Listing<StatusCheck> = new {}
  requiredApprovingReviewCount: Int?
  dismissStaleReviews: Boolean = false
  requireCodeOwnerReviews: Boolean = false
  requireLastPushApproval: Boolean?
  users: Listing<String> = new {}
  teams: Listing<String> = new {}
  apps: Listing<String> = new {}
}

class Pages {
  buildType: "workflow" | "legacy" = "workflow"
  /// Required when buildType = "legacy"
  sourceBranch: String?
  /// Required when buildType = "legacy"
  sourcePath: String?
}

/// Deployment environment. The environment name is the key in Repository.environments.
class Environment {
  secrets: Listing<String> = new {}
  waitTimer: Int = 0
  protectedBranches: Boolean = false
  customBranchPolicies: Boolean = false
}

/// Desired state for a single GitHub repository.
/// Defaults match GitHub's defaults for newly-created repos.
class Repository {
  name: String
  managed: Managed = new {}
  archived: Boolean = false
  description: String = ""
  homepageUrl: String = ""
  visibility: Visibility = "public"
  topics: Listing<String> = new {}
  defaultBranch: String = "main"

  hasIssues: Boolean = true
  hasProjects: Boolean = true
  hasWiki: Boolean = true
  hasDiscussions: Boolean = false
  isTemplate: Boolean = false
  allowForking: Boolean = true
  webCommitSignoffRequired: Boolean = false

  allowMergeCommit: Boolean = true
  allowSquashMerge: Boolean = true
  allowRebaseMerge: Boolean = true
  allowAutoMerge: Boolean = false
  deleteBranchOnMerge: Boolean = false
  allowUpdateBranch: Boolean = false
  squashMergeCommitTitle: SquashMergeCommitTitle = "COMMIT_OR_PR_TITLE"
  squashMergeCommitMessage: SquashMergeCommitMessage = "COMMIT_MESSAGES"
  mergeCommitTitle: MergeCommitTitle = "MERGE_MESSAGE"
  mergeCommitMessage: MergeCommitMessage = "PR_TITLE"

  vulnerabilityAlerts: Boolean = true
  automatedSecurityFixes: Boolean = false
  secretScanning: Boolean = true
  secretScanningPushProtection: Boolean = true
  secretScanningValidityChecks: Boolean = false
  secretScanningNonProviderPatterns: Boolean = false
  privateVulnerabilityReporting: Boolean = false
  codeScanningDefaultSetup: Boolean = false
  advancedSecurity: Boolean = false
  secretScanningAiDetection: Boolean = false
  secretScanningDelegatedAlertDismissal: Boolean = false
  secretScanningDelegatedBypass: Boolean = false
  secretScanningDelegatedBypassReviewers: Listing<SecretScanningBypassReviewer> = new {}

  defaultWorkflowPermissions: WorkflowPermissions = "write"
  canApprovePullRequestReviews: Boolean = true

  immutableReleases: Boolean = false
  pages: Pages?
  actionsSecrets: Listing<String> = new {}

  /// Keyed by branch pattern (e.g. "main")
  branchProtections: Mapping<String, BranchProtection> = new {}
  /// Keyed by ruleset name
  rulesets: Mapping<String, Ruleset> = new {}
  /// Keyed by environment name
  environments: Mapping<String, Environment> = new {}
}

class SelectedActions {
  githubOwnedAllowed: Boolean = true
  verifiedAllowed: Boolean = false
  patternsAllowed: Listing<String> = new {}
}

/// Organization Actions policy. Which repositories are selected under
/// enabledRepositories = "selected" is not managed: drifty writes the policy
/// value and GitHub keeps the existing selection.
class ActionsPermissions {
  enabledRepositories: ActionsEnabledRepositories = "all"
  allowedActions: AllowedActions = "all"
  shaPinningRequired: Boolean = false
  /// Required when allowedActions = "selected"
  selectedActions: SelectedActions?
}

/// An organization Actions secret. The name is the key in
/// Organization.actionsSecrets; the value comes from DRIFTY_GITHUB_SECRETS
/// under the key `org-<org>-<secret>`.
class OrgSecret {
  visibility: SecretVisibility = "private"
  /// Only when visibility = "selected"
  selectedRepositories: Listing<String> = new {}
}

/// Desired state for a GitHub organization, keyed by login in `organizations`.
/// Defaults match GitHub's defaults for a new organization.
class Organization {
  managed: OrgManaged = new {}

  displayName: String = ""
  description: String = ""
  websiteUrl: String = ""
  company: String = ""
  email: String = ""
  location: String = ""
  twitterUsername: String = ""

  hasOrganizationProjects: Boolean = true
  hasRepositoryProjects: Boolean = true
  defaultRepositoryPermission: RepositoryPermission = "read"
  membersCanCreateRepositories: Boolean = true
  membersCanCreatePublicRepositories: Boolean = true
  membersCanCreatePrivateRepositories: Boolean = true
  membersCanCreateInternalRepositories: Boolean = false
  membersCanCreatePages: Boolean = true
  membersCanCreatePublicPages: Boolean = true
  membersCanCreatePrivatePages: Boolean = true
  membersCanForkPrivateRepositories: Boolean = false
  webCommitSignoffRequired: Boolean = false
  deployKeysEnabledForRepositories: Boolean = false

  /// Check-only below: GitHub returns these but PATCH /orgs/{org} accepts
  /// none of them, so drifty reports drift and never writes it.
  defaultRepositoryBranch: String = "main"
  twoFactorRequirementEnabled: Boolean = false
  membersCanDeleteRepositories: Boolean = true
  membersCanChangeRepoVisibility: Boolean = true
  membersCanInviteOutsideCollaborators: Boolean = true
  membersCanDeleteIssues: Boolean = false
  membersCanCreateTeams: Boolean = true
  membersCanViewDependencyInsights: Boolean = true
  readersCanCreateDiscussions: Boolean = false
  displayCommenterFullNameSettingEnabled: Boolean = false

  actionsPermissions: ActionsPermissions = new {}
  defaultWorkflowPermissions: WorkflowPermissions = "write"
  canApprovePullRequestReviews: Boolean = true

  /// Keyed by secret name
  actionsSecrets: Mapping<String, OrgSecret> = new {}

  repositories: Listing<Repository> = new {}
}

/// A personal account. It owns repositories and has no org-level settings —
/// which is why it is a separate type rather than a flag on Organization.
class User {
  repositories: Listing<Repository> = new {}
}

organizations: Mapping<String, Organization> = new {}
users: Mapping<String, User> = new {}

output {
  value = new Dynamic {
    organizations = module.organizations
    users = module.users
  }
}
