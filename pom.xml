<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath />
	</parent>

	<groupId>io.github.arlol</groupId>
	<artifactId>drifty</artifactId>
	<version>${revision}</version>

	<properties>
		<java.version>25</java.version>
		<sha1>HEAD</sha1>
		<revision>0.0.1-SNAPSHOT</revision>
		<platform>unknown</platform>
		<start-class>io.github.arlol.githubcheck.GitHubCheck</start-class>
		<project.build.outputTimestamp>2023-01-01T00:00:00Z</project.build.outputTimestamp>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.organization>arlol</sonar.organization>
		<sonar.projectKey>ArloL_drifty</sonar.projectKey>
		<!-- Same reason as the jacoco excludes below, one layer up: Sonar's
		     new-code quality gate was grading pkl-codegen-java's output, where
		     nothing a reviewer can act on lives. -->
		<sonar.exclusions>target/generated-sources/**/*</sonar.exclusions>
		<!-- The one pkl pin. The code generator, the formatter the export is
		     held to and the CLI main.yaml downloads are the same release, and
		     the workflow reads this property rather than repeating it: a
		     formatter checking drifty's output against different rules than
		     the binary an adopter's CI runs is the failure this pin exists to
		     make impossible. -->
		<pkl.version>0.32.1</pkl.version>
		<error-prone.version>2.50.0</error-prone.version>
		<nullaway.version>0.14.1</nullaway.version>
	</properties>

	<profiles>
		<profile>
			<id>macos</id>
			<activation>
				<os>
					<family>mac</family>
				</os>
			</activation>
			<properties>
				<platform>macos</platform>
			</properties>
		</profile>
		<profile>
			<id>unix</id>
			<activation>
				<os>
					<family>unix</family>
					<name>Linux</name>
				</os>
			</activation>
			<properties>
				<platform>linux</platform>
			</properties>
		</profile>
		<profile>
			<id>windows</id>
			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>
			<properties>
				<platform>windows</platform>
			</properties>
		</profile>
		<profile>
			<id>graal</id>
			<activation>
				<file>
					<exists>${env.JAVA_HOME}/lib/graal</exists>
				</file>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>build-native</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
							<execution>
								<id>test-native</id>
								<goals>
									<goal>test</goal>
								</goals>
								<configuration>
									<!--
										-Ob: the test image exists to run the suite against
										the reachability metadata, not to be fast, and the
										economy compiler takes a third off its compile phase.
										The production image below stays fully optimized.
									-->
									<quickBuild>true</quickBuild>
								</configuration>
							</execution>
						</executions>
						<configuration>
							<agent>
								<enabled>false</enabled>
								<options>
									<accessFilterFiles>
										<filterFile>${project.basedir}/src/main/resources/META-INF/native-image/access-filter.json</filterFile>
									</accessFilterFiles>
								</options>
								<metadataCopy>
									<disabledStages>
										<stage>main</stage>
									</disabledStages>
									<merge>true</merge>
									<outputDirectory>${project.basedir}/src/main/resources/META-INF/native-image</outputDirectory>
								</metadataCopy>
							</agent>
							<imageName>${project.artifactId}-${platform}-${project.version}</imageName>
							<metadataRepository>
								<enabled>true</enabled>
							</metadataRepository>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<configuration>
							<mainClass>${start-class}</mainClass>
							<arguments>
								<argument>
									-agentlib:native-image-agent=config-merge-dir=${project.basedir}/src/main/resources/META-INF/native-image,access-filter-file=${project.basedir}/src/main/resources/META-INF/native-image/access-filter.json
								</argument>
								<argument>-classpath</argument>
								<classpath />
								<argument>${start-class}</argument>
							</arguments>
						</configuration>
					</plugin>
					<plugin>
						<artifactId>maven-failsafe-plugin</artifactId>
						<configuration>
							<systemPropertyVariables>
								<native.executable>${project.build.directory}/${project.artifactId}-${platform}-${project.version}</native.executable>
								<project.artifactId>${project.artifactId}</project.artifactId>
								<project.version>${project.version}</project.version>
							</systemPropertyVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>env-build-timestamp</id>
			<activation>
				<property>
					<name>env.BUILD_TIMESTAMP</name>
				</property>
			</activation>
			<properties>
				<project.build.outputTimestamp>${env.BUILD_TIMESTAMP}</project.build.outputTimestamp>
			</properties>
		</profile>
	</profiles>

	<dependencies>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>com.goterl</groupId>
			<artifactId>lazysodium-java</artifactId>
			<version>5.2.0</version>
		</dependency>
		<dependency>
			<groupId>net.java.dev.jna</groupId>
			<artifactId>jna</artifactId>
			<!--
				5.19.x is not in the reachability-metadata repository's
				tested-versions, so the plugin falls back to the latest config
				(net.java.dev.jna/jna/5.8.0). That config is missing the
				Structure$FFIType entries, so the JNA reflection metadata is
				self-supplied here and NativeExecutableIT.selfTest guards it.
				See FOLLOWUPS.md before touching this.
			-->
			<version>5.19.1</version>
		</dependency>

		<dependency>
			<groupId>net.jcip</groupId>
			<artifactId>jcip-annotations</artifactId>
			<version>1.0</version>
			<optional>true</optional>
		</dependency>
		<dependency>
			<!--
				The module artifact, not the io.github.arlol:pkl-config-java-native
				aggregate jitpack builds for the repository root: that one also
				depends on pkl-config-java-native-it, whose test classes would
				otherwise ship in the native image.
			-->
			<groupId>io.github.arlol.pkl-config-java-native</groupId>
			<artifactId>pkl-config-java-native</artifactId>
			<version>2609.0.114</version>
		</dependency>

		<dependency>
			<groupId>org.jspecify</groupId>
			<artifactId>jspecify</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.spotbugs</groupId>
			<artifactId>spotbugs-annotations</artifactId>
			<version>4.10.4</version>
			<optional>true</optional>
		</dependency>

		<!-- Test dependencies -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-core</artifactId>
			<version>4.0.0-beta.38</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-jetty</artifactId>
			<version>4.0.0-beta.38</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-junit5</artifactId>
			<version>4.0.0-beta.38</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-httpclient-apache5</artifactId>
			<version>4.0.0-beta.38</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.awaitility</groupId>
			<artifactId>awaitility</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- The formatter `pkl format` itself runs, so the exported file
			     is checked against the real rules rather than against
			     PklWriterTest's model of them. Test scope: nothing in the
			     shipped binary formats anything. -->
			<groupId>org.pkl-lang</groupId>
			<artifactId>pkl-formatter</artifactId>
			<version>${pkl.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.github.classgraph</groupId>
			<artifactId>classgraph</artifactId>
			<version>4.8.195</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!-- Error Prone is here only to carry NullAway: every
					     other check it ships is disabled. "null means
					     unmanaged" decides whether a code security sub-option
					     is compared at all, and it was enforced by prose and
					     by jspecify being on the classpath with nothing
					     reading it. -->
					<compilerArgs>
						<arg>-XDcompilePolicy=simple</arg>
						<!-- javac stops listing at 100, which reads as a
						     plateau when you are working a backlog down. -->
						<arg>-Xmaxerrs</arg>
						<arg>10000</arg>
						<arg>--should-stop=ifError=FLOW</arg>
						<!-- Kept on one line: this is a single javac flag
						     whose value happens to contain spaces.
						     -XepExcludedPaths takes a colon, not an equals —
						     an equals is reported as "invalid flag" with the
						     rest of the line parsing fine, which reads like a
						     quoting problem and is not one. Drifty.java is
						     what it excludes: pkl-codegen-java emits it, and
						     it is not annotated. -->
						<arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:AnnotatedPackages=io.github.arlol.githubcheck -XepExcludedPaths:.*/generated-sources/.*</arg>
					</compilerArgs>
					<annotationProcessorPaths>
						<path>
							<groupId>com.google.errorprone</groupId>
							<artifactId>error_prone_core</artifactId>
							<version>${error-prone.version}</version>
						</path>
						<path>
							<groupId>com.uber.nullaway</groupId>
							<artifactId>nullaway</artifactId>
							<version>${nullaway.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
				<executions>
					<execution>
						<!-- Main sources only. Test code constructs absent
						     values on purpose — a response with the section
						     missing, a config that sets nothing, a secret with
						     no baseline — which is the behaviour under test and
						     not a defect: NullAway reported 526 of them against
						     zero in src/main. Checking the code that ships is
						     the whole of what this buys. -->
						<id>default-testCompile</id>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<compilerArgs combine.self="override" />
							<annotationProcessorPaths combine.self="override" />
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>pkl-add-source</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-sources/pkl/java</source>
							</sources>
						</configuration>
					</execution>
					<execution>
						<id>pkl-add-resource</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>add-resource</goal>
						</goals>
						<configuration>
							<resources>
								<resource>
									<directory>
										${project.build.directory}/generated-sources/pkl/resources</directory>
								</resource>
								<!-- The schema the binary answers its own main-branch
								     URL with; see BundledSchema. -->
								<resource>
									<directory>${project.basedir}/config</directory>
									<includes>
										<include>drifty.pkl</include>
									</includes>
									<targetPath>io/github/arlol/githubcheck</targetPath>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforcer-enforce</id>
						<goals>
							<goal>enforce</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<rules>
						<requireMavenVersion>
							<version>3.9.16</version>
						</requireMavenVersion>
						<requirePluginVersions />
						<bannedDependencies>
							<excludes>
								<!-- disallow all system scope dependencies -->
								<exclude>*:*:*:*:system</exclude>
							</excludes>
						</bannedDependencies>
						<reactorModuleConvergence />
						<banDuplicatePomDependencyVersions />
					</rules>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>de.smartics.rules</groupId>
						<artifactId>smartics-enforcer-rules</artifactId>
						<version>1.0.2</version>
					</dependency>
				</dependencies>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>1.8.0</version>
				<configuration>
					<updatePomFile>true</updatePomFile>
					<flattenMode>resolveCiFriendliesOnly</flattenMode>
				</configuration>
				<executions>
					<execution>
						<id>flatten-clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
					<execution>
						<id>flatten-flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>versions-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>versions-set</id>
						<phase>process-resources</phase>
						<goals>
							<goal>set-property</goal>
						</goals>
						<configuration>
							<generateBackupPoms>false</generateBackupPoms>
							<newVersion>${project.build.outputTimestamp}</newVersion>
							<property>project.build.outputTimestamp</property>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>net.revelc.code.formatter</groupId>
				<artifactId>formatter-maven-plugin</artifactId>
				<version>2.29.0</version>
				<configuration>
					<configFile>${project.basedir}/.settings/code-formatter-profile.xml</configFile>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>format</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.10.4.1</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Low</threshold>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.gaul</groupId>
				<artifactId>modernizer-maven-plugin</artifactId>
				<version>3.5.0</version>
				<configuration>
					<javaVersion>${java.version}</javaVersion>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>modernizer</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- Mutation testing. Not bound to a phase: a run mutates the
				     drift and export packages and re-runs the suite against
				     each surviving mutant, which is minutes rather than
				     seconds, so it is asked for rather than paid for on every
				     build:

				       ./mvnw test-compile pitest:mutationCoverage

				     What it answers that jacoco cannot: these two packages are
				     tables — a Setting row pairs a comparison with the builder
				     call that writes it, an exporter line pairs a field with
				     its schema default — and a table is the shape most likely
				     to be executed by a test that asserts nothing about it.
				     Line coverage says the row ran; a surviving mutant says
				     nothing checked what it did.

				     The report lands in target/pit-reports. -->
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>1.30.0</version>
				<configuration>
					<targetClasses>
						<param>io.github.arlol.githubcheck.drift.*</param>
						<param>io.github.arlol.githubcheck.export.*</param>
					</targetClasses>
					<!-- Drifty.java is generated, and mutating a generated
					     equals() measures pkl-codegen-java. -->
					<excludedClasses>
						<param>io.github.arlol.githubcheck.pkl.*</param>
					</excludedClasses>
					<!-- *IT is failsafe's: NativeExecutableIT runs the built
					     binary, which a pitest run has not produced, and PIT
					     refuses to start unless every test it sees is green.
					     -->
					<excludedTestClasses>
						<param>io.github.arlol.githubcheck.*IT</param>
					</excludedTestClasses>
					<outputFormats>
						<param>HTML</param>
						<param>XML</param>
					</outputFormats>
					<timestampedReports>false</timestampedReports>
					<!-- 85 against the 90.1% measured on 2026-09-20 (1118
					     mutations, 1007 killed). The five points of headroom
					     are for a change that legitimately adds a branch
					     before the test that pins it; they are not a budget to
					     spend. The 111 that survive are concentrated in
					     RulesetComparison (28), RepositoryExporter (15) and
					     AccountExporter (12), and 63 of them are a removed
					     void call — an `items.add(...)` whose absence no
					     assertion notices. Raise the bound as those come
					     down. -->
					<mutationThreshold>85</mutationThreshold>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-junit5-plugin</artifactId>
						<version>1.2.3</version>
					</dependency>
				</dependencies>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<configuration>
					<!-- Drifty.java is pkl-codegen-java's output from
					     config/drifty.pkl, and measuring it reports on the
					     generator rather than on drifty: its withX, equals and
					     toString are emitted for every field whether or not
					     anything calls them. Counting them put the whole
					     project at 73.5% instruction and 59.3% branch against
					     the 91.9%/80.8% the hand-written code actually holds,
					     which is a threshold that moves when a schema field is
					     added and not when a test is deleted. -->
					<excludes>
						<exclude>io/github/arlol/githubcheck/pkl/**</exclude>
					</excludes>
					<!-- The rules sit here rather than in the check execution
					     so `./mvnw jacoco:check` answers the same question the
					     build does, instead of passing with no rules at all.

					     80% against the 92.1% line and 81.8% branch the suite
					     holds today. Line has room; branch has 1.8 points,
					     which is the point — the branches drifty does not
					     reach are concentrated in GitHubClient's transport
					     arms (65.1%) and GitHubCheck's argument handling
					     (72.2%), so a bound that bites is one that notices a
					     new arm going in untested. Raise it when those two
					     come up; do not raise it by excluding them. -->
					<rules>
						<rule>
							<element>BUNDLE</element>
							<limits>
								<limit>
									<counter>LINE</counter>
									<value>COVEREDRATIO</value>
									<minimum>0.80</minimum>
								</limit>
								<limit>
									<counter>BRANCH</counter>
									<value>COVEREDRATIO</value>
									<minimum>0.80</minimum>
								</limit>
							</limits>
						</rule>
					</rules>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<!-- verify, so it runs after the report the whole
						     suite feeds. `./mvnw test` does not reach it. -->
						<id>check</id>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
					<doclint>-missing</doclint>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.6.4</version>
				<configuration>
					<mainClass>${start-class}</mainClass>
					<executable>${env.JAVA_HOME}/bin/java</executable>
					<arguments>
						<argument>-classpath</argument>
						<classpath />
						<argument>${start-class}</argument>
						<argument>--no-fix</argument>
						<argument>--config</argument>
						<argument>./config/example.pkl</argument>
					</arguments>
				</configuration>
				<executions>
					<execution>
						<id>pkl-codegen-java</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration combine.self="override">
							<includePluginDependencies>true</includePluginDependencies>
							<mainClass>org.pkl.codegen.java.Main</mainClass>
							<arguments>
								<argument>--output-dir</argument>
								<argument>${project.build.directory}/generated-sources/pkl</argument>
								<argument>--rename</argument>
								<argument>drifty=io.github.arlol.githubcheck.pkl.Drifty</argument>
								<argument>${project.basedir}/config/drifty.pkl</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<!-- Split the native-image agent dump into the scoped
						     reachability-metadata.json files. Invoke manually:
						     ./mvnw test-compile exec:java@reachability-metadata -->
						<id>reachability-metadata</id>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration combine.self="override">
							<mainClass>io.github.arlol.githubcheck.ReachabilityMetadata</mainClass>
							<classpathScope>test</classpathScope>
						</configuration>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>org.pkl-lang</groupId>
						<artifactId>pkl-codegen-java</artifactId>
						<version>${pkl.version}</version>
					</dependency>
					<dependency>
						<groupId>com.github.ajalt.clikt</groupId>
						<artifactId>clikt-markdown-jvm</artifactId>
						<version>5.1.0</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<artifactId>maven-resources-plugin</artifactId>
					<configuration>
						<propertiesEncoding>ISO-8859-1</propertiesEncoding>
					</configuration>
				</plugin>
				<plugin>
					<artifactId>maven-site-plugin</artifactId>
					<version>3.22.0</version>
				</plugin>
				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>5.8.0.7211</version>
				</plugin>
				<plugin>
					<groupId>org.graalvm.buildtools</groupId>
					<artifactId>native-maven-plugin</artifactId>
					<version>1.1.12</version>
					<extensions>true</extensions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
	<repositories>
		<!-- central must come before jitpack: jitpack auto-generates stub
			POMs for com.github.* coordinates (e.g. the handlebars.java parent
			POM, without packaging "pom"), which would otherwise shadow the
			real artifacts and silently drop transitive dependencies -->
		<repository>
			<id>central</id>
			<url>https://repo.maven.apache.org/maven2</url>
		</repository>
		<repository>
			<id>jitpack.io</id>
			<url>https://jitpack.io</url>
		</repository>
	</repositories>
</project>
